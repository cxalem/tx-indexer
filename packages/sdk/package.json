{
  "name": "tx-indexer",
  "version": "2.0.0",
  "description": "A TypeScript SDK that transforms raw Solana transactions into human-readable financial data with automatic classification and protocol detection",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "STABILITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "test:dist": "bun test ./test-dist",
    "build:verify": "bun run build && bun run test:dist",
    "prepublishOnly": "bun run build:verify",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src/client.test.ts src/nft.test.ts src/wallet-api.test.ts src/alt-replay.test.ts src/legacy-input.test.ts src/legacy-digests.test.ts src/spam-filter-input.test.ts",
    "test:integration": "bun test src/__tests__/integration.test.ts",
    "test:all": "bun test",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "keywords": [
    "solana",
    "blockchain",
    "transaction",
    "indexer",
    "classifier",
    "sdk",
    "web3",
    "defi",
    "typescript",
    "transaction-classification"
  ],
  "author": "cxalem",
  "repository": {
    "type": "git",
    "url": "https://github.com/cxalem/tx-indexer.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://itx-indexer.com/",
  "bugs": "https://github.com/cxalem/tx-indexer/issues",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@size-limit/rolldown-why": "^14.3.0",
    "@solana/kit": "^8.6.0",
    "@tx-indexer/classification": "workspace:*",
    "@tx-indexer/core": "workspace:*",
    "@tx-indexer/solana": "workspace:*",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6",
    "@solana/kit": "^8.0.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
