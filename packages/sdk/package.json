{
  "name": "tx-indexer",
  "version": "1.5.0",
  "description": "A TypeScript SDK that transforms raw Solana transactions into human-readable financial data with automatic classification and protocol detection",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "STABILITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "test:dist": "bun test ./test-dist",
    "build:verify": "bun run build && bun run test:dist",
    "prepublishOnly": "bun run build:verify",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src/client.test.ts src/nft.test.ts src/wallet-api.test.ts src/alt-replay.test.ts",
    "test:integration": "bun test src/__tests__/integration.test.ts",
    "test:all": "bun test",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "keywords": [
    "solana",
    "blockchain",
    "transaction",
    "indexer",
    "classifier",
    "sdk",
    "web3",
    "defi",
    "typescript",
    "transaction-classification"
  ],
  "author": "cxalem",
  "repository": {
    "type": "git",
    "url": "https://github.com/cxalem/tx-indexer.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://itx-indexer.com/",
  "bugs": "https://github.com/cxalem/tx-indexer/issues",
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/esbuild-why": "^14.3.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@solana/kit": "^5.0.0",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6",
    "@solana/kit": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.1.13"
  }
}
